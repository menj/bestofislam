{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Best of Islam Night",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#0A2038", "name": "Deep navy" },
				{ "slug": "contrast", "color": "#EAF2FB", "name": "Pale blue" },
				{ "slug": "accent-1", "color": "#3FA9F5", "name": "Sky" },
				{ "slug": "accent-2", "color": "#E8B33C", "name": "Gold" },
				{ "slug": "accent-3", "color": "#0F2B49", "name": "Panel" },
				{ "slug": "accent-4", "color": "#1F6FCC", "name": "Azure" },
				{ "slug": "accent-5", "color": "#9DB3C9", "name": "Slate" },
				{ "slug": "accent-6", "color": "#1A3555", "name": "Rule" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--accent-1)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent-1)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "var(--wp--custom--radius--pill)" }
			}
		}
	}
}
