# Written by the Best of Islam theme. Nothing in this folder serves a page:
# Apache refuses every request into it, whatever the address of the theme
# folder. inc/housekeeping.php deletes the folder on production.
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order deny,allow
Deny from all
</IfModule>
